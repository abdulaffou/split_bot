# --- Instagram API with Instagram Login (graph.instagram.com) ---
# Long-lived Instagram User access token (from Business Login for Instagram).
# This is the pure-Instagram product — NOT a Facebook Page token.
META_ACCESS_TOKEN=your_instagram_user_access_token
META_VERIFY_TOKEN=choose_any_secret_string
# App secret from the Meta app dashboard (App Settings > Basic). Used to verify
# the X-Hub-Signature-256 header. Leave blank in dev to skip verification.
META_APP_SECRET=your_meta_app_secret
# Instagram app secret (Products → Instagram → API setup with Instagram Login).
# IG-Login webhooks are often signed with this instead. Set both; the check
# tries each and logs which one matched.
INSTAGRAM_APP_SECRET=your_instagram_app_secret
GRAPH_API_VERSION=v25.0
# Send host. graph.instagram.com = Instagram-Login product (default).
GRAPH_API_HOST=graph.instagram.com
# Optional: your own account's IGSID. If set, inbound events from your own
# account are dropped as a second echo guard (with message.is_echo).
INSTAGRAM_ACCOUNT_ID=

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
# gemini-1.5-flash is retired. Use gemini-3.1-flash-lite (cheapest, free tier)
# or gemini-3.5-flash (smarter). Both are on the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
