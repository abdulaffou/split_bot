# --- Meta Instagram Graph API (Messenger platform) ---
# Permanent Page Access Token for the Facebook Page linked to the IG account.
META_ACCESS_TOKEN=your_permanent_page_access_token
META_VERIFY_TOKEN=choose_any_secret_string
# App secret from the Meta app dashboard (Settings > Basic). Used to verify the
# X-Hub-Signature-256 header. Leave blank in dev to skip verification.
META_APP_SECRET=your_meta_app_secret
GRAPH_API_VERSION=v25.0
# Optional: your own account's IGSID. If set, inbound events from your own
# account are dropped as a second echo guard (with message.is_echo).
INSTAGRAM_ACCOUNT_ID=

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key
# gemini-1.5-flash is retired. Use gemini-3.1-flash-lite (cheapest, free tier)
# or gemini-3.5-flash (smarter). Both are on the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
